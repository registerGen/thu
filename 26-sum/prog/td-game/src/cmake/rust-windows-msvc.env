# Source this before configuring/building the Rust-backend app for Windows MSVC:
#
#   . cmake/rust-windows-msvc.env
#   cmake -B build-win -DCMAKE_TOOLCHAIN_FILE=$PWD/cmake/toolchain-windows-msvc.cmake \
#       -DTD_USE_RUST_MODEL=ON -DTD_BUILD_APP=ON -DTD_BUILD_TESTS=OFF
#   cmake --build build-win -j
#
# Pairs with cmake/toolchain-windows-msvc.cmake (clang-cl + lld-link + xwin at
# /opt/xwin, Qt at /opt/qt6-xwin). Do NOT set CARGO_BUILD_TARGET globally:
# Corrosion auto-detects x86_64-pc-windows-msvc from CMAKE_SYSTEM_NAME, and a
# global target would build the cxxbridge host codegen tool for Windows (a .exe
# that can't run on Linux).

# cc-rs (used by the cxx / link-cplusplus build scripts) searches for MSVC tool
# names; provide them as symlinks to the LLVM tools. (Harmless on the PATH for
# native builds — Linux CMake looks for cc/c++/gcc/clang, never cl.exe/lib.exe.)
XWIN_BIN="${XWIN_BIN:-$HOME/.local/xwin-bin}"
mkdir -p "$XWIN_BIN"
ln -sf "$(command -v llvm-lib-23)"  "$XWIN_BIN/lib.exe"
ln -sf "$(command -v clang-cl-23)"  "$XWIN_BIN/cl.exe"
export PATH="$XWIN_BIN:$PATH"

# Tell cc-rs which compiler/archiver to drive for the msvc target.
export CC_x86_64_pc_windows_msvc=clang-cl-23
export CXX_x86_64_pc_windows_msvc=clang-cl-23
export AR_x86_64_pc_windows_msvc=llvm-lib-23

# xwin SDK + MSVC headers, and match Qt's static CRT (/MT). `-std=c++20` is
# required for the `cxx` runtime (cxx.cc): the cxx crate's own build script
# compiles it with cc-rs's c++11 default, which can't parse the MSVC stdlib
# headers (needs C++14+).
#
# IMPORTANT: these are cc-rs *target-specific* env vars (CFLAGS_<triple>), NOT
# the global CFLAGS/CXXFLAGS. CMake only reads the global ones, so using the
# target-specific form keeps a native `cmake -B build ...` (run in the same
# sourced shell) from caching these flags into CMAKE_C_FLAGS/CMAKE_CXX_FLAGS
# and poisoning the Linux build.
XWIN_INC="-isystem /opt/xwin/crt/include -isystem /opt/xwin/sdk/include/ucrt -isystem /opt/xwin/sdk/include/shared -isystem /opt/xwin/sdk/include/um -isystem /opt/xwin/sdk/include/winrt -D_MT -Xclang --dependent-lib=libcmt"
export CFLAGS_x86_64_pc_windows_msvc="-isystem /opt/xwin/crt/include -isystem /opt/xwin/sdk/include/ucrt -isystem /opt/xwin/sdk/include/shared -isystem /opt/xwin/sdk/include/um -D_MT -Xclang --dependent-lib=libcmt"
export CXXFLAGS_x86_64_pc_windows_msvc="$XWIN_INC -std=c++20"
